{
  "inputs": [
    {
      "id": "azure-devops-pat",
      "type": "promptString",
      "description": "Azure DevOps Personal Access Token",
      "password": true
    },
    {
      "id": "github-pat",
      "type": "promptString",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ],
  "mcp": {
    "servers": {
      "BDOInternal": {
        "command": "cmd",
        "args": ["/c", "npx", "-y", "mcp-server-azure-devops"],
        "env": {
          "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/BDOInternal",
          "AZURE_DEVOPS_PAT": "${input:azure-devops-pat}"
        }
      },
      "GitHub": {
        "command": "docker",
        "args": [
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-pat}"
        }
      }
    }
  }
}